@article{hamilton2025neurosymbolic,
  title     = {Neuro-symbolic AI for Predictive Maintenance (PdM) - Review and Recommendations},
  author    = {Hamilton, K.},
  year      = {2025},
  eprint    = {2602.00731},
  archiveprefix = {arXiv},
  url       = {https://arxiv.org/html/2602.00731v1},
  abstract  = {Revisión sistemática de PdM en los últimos 5 años en entornos industriales. Propone arquitecturas neuro-simbólicas que integran datos de series temporales con reglas lógicas. Identifica que los métodos data-driven tienen mayor precisión, pero carecen de interpretabilidad y requieren grandes volúmenes de datos etiquetados.}
}

@inproceedings{zheng2020advancing,
  title     = {Advancing from Predictive Maintenance to Intelligent Maintenance with AI and IIoT},
  author    = {Zheng, H. and Paiva, A.R. and Gurciullo, C.S.},
  year      = {2020},
  booktitle = {AIoT Workshop at KDD 2020},
  eprint    = {2009.00351},
  archiveprefix = {arXiv},
  url       = {https://arxiv.org/pdf/2009.00351},
  abstract  = {Propone un framework de Mantenimiento Inteligente basado en 5 pilares: ML probabilístico, sensores IoT, Big Data, CI/CD de modelos, y movilidad/AR/VR. Demuestra un enfoque con Bayesian Recurrent Neural Networks (BRNN) en el dataset de degradación Turbofan de NASA.}
}

@article{millingmachine2024,
  title     = {Research on Milling Machine Predictive Maintenance Based on Machine Learning and SHAP Analysis in Intelligent Manufacturing Environment},
  author    = {{Investigación sobre Fresadoras}},
  year      = {2024},
  eprint    = {2512.01205},
  archiveprefix = {arXiv},
  url       = {https://arxiv.org/html/2512.01205v1},
  abstract  = {Compara 8 modelos de ML (XGBoost, Random Forest, Gradient Boosting, SVM, KNN, etc.) usando el dataset AI4I 2020. Los modelos ensemble como Gradient Boosting (R²=0.774) y XGBoost obtienen los mejores resultados. Utiliza SHAP para revelar que temperatura de proceso, torque y velocidad son los factores clave de fallo.}
}

@article{maheshwari2024comprehensive,
  title     = {Comprehensive Study Of Predictive Maintenance In Industries Using Classification Models And LSTM Model},
  author    = {Maheshwari, S. and others},
  year      = {2024},
  eprint    = {2403.10259},
  archiveprefix = {arXiv},
  url       = {https://arxiv.org/pdf/2403.10259},
  abstract  = {Evalúa SVM (96.5\% accuracy), Logistic Regression (92.5\%), Random Forest y LSTM para predicción de fallos. Concluye que LSTM supera consistentemente a los modelos clásicos por su capacidad de capturar dependencias temporales.}
}

@article{khemani2025aidriven,
  title     = {AI-Driven Predictive Maintenance with Real-Time Contextual Data Fusion for Connected Vehicles},
  author    = {Khemani, K. and Qureshi, A.N.},
  year      = {2025},
  eprint    = {2603.13343},
  archiveprefix = {arXiv},
  url       = {https://arxiv.org/html/2603.13343v1},
  abstract  = {Framework que integra señales internas (OBD-II) con datos contextuales V2X (clima, tráfico, calidad del camino). LightGBM alcanza AUC-ROC de 0.973 en el benchmark AI4I 2020. Análisis de sensibilidad al ruido muestra que F1 se mantiene >0.88 con ruido moderado.}
}

@article{serradilla2020deeplearning,
  title     = {Deep learning models for predictive maintenance: a survey, comparison, challenges and prospect},
  author    = {Serradilla, O. and Zugasti, E. and Zurutuza, U.},
  year      = {2020},
  eprint    = {2010.03207},
  archiveprefix = {arXiv},
  url       = {https://arxiv.org/pdf/2010.03207},
  abstract  = {Survey exhaustivo que clasifica técnicas DL (CNN, LSTM/GRU, AE, DBN, GAN, SOM) por etapas de PdM: detección de anomalías, diagnóstico, pronóstico y mitigación. Identifica que la combinación CNN + LSTM en autoencoders es la arquitectura más exitosa para modelado no supervisado.}
}

@article{tran2024robust,
  title     = {A Robust Deep Learning System for Motor Bearing Fault Detection},
  author    = {Tran, K. and others},
  year      = {2024},
  eprint    = {2310.11477},
  archiveprefix = {arXiv},
  url       = {https://arxiv.org/pdf/2310.11477},
  abstract  = {Propone Robust-MBFD, un sistema que integra aprendizaje supervisado, semi-supervisado y no supervisado. Introduce una función de doble pérdida (Triplet + Center loss) para mejor separación de clases. Evaluado en datasets MFPT (99.9\%), CWRU (~90\%) y PU (72.72\% en escenario cross-domain).}
}

@article{tqrnn2024transformer,
  title     = {Industrial Machines Health Prognosis using a Transformer-based Framework},
  author    = {{TQRNNs}},
  year      = {2024},
  eprint    = {2411.14443},
  archiveprefix = {arXiv},
  url       = {https://arxiv.org/html/2411.14443v1},
  abstract  = {Introduce Transformer Quantile Regression Neural Networks para predicción de fallos en tiempo real en industria de bebidas. Alcanza 70.84\% de precisión con 1 hora de anticipación. Mejora el rendimiento de producción de 78.38\% a 89.62\%, reduciendo tiempo de inactividad de 60 a 5 horas/mes.}
}

@article{pmidt2024digitaltwin,
  title     = {PMI-DT: Leveraging Digital Twins and Machine Learning for Predictive Modeling and Inspection in Manufacturing},
  author    = {{PMI-DT Framework}},
  year      = {2024},
  eprint    = {2411.01299},
  archiveprefix = {arXiv},
  url       = {https://arxiv.org/html/2411.01299v1},
  abstract  = {Propone el framework PMI-DT que combina gemelos digitales (Microsoft Azure) con ML (Random Forest, Decision Tree). Logra 100\% de precisión en predicción de fallos de pernos ACME impresos en 3D. Identifica Max Position (30\%) y Max Load (24\%) como los factores más influyentes en el fallo.}
}

@article{llmfault2024consultation,
  title     = {Consultation on Industrial Machine Faults with Large Language Models},
  author    = {{LLM Fault Consultation}},
  year      = {2024},
  eprint    = {2410.03223},
  archiveprefix = {arXiv},
  url       = {https://arxiv.org/html/2410.03223v1},
  abstract  = {Propone un enfoque de prompting multi-ronda con GPT-4 para diagnóstico de fallos industriales. Alcanza 91\% de precisión en diagnóstico de desalineación (90\%), desgaste de rodamientos (88\%) y sobrecalentamiento (95\%). Supera a ChatGPT (65\%), Claude 2 (72\%) y Chain-of-Thought (77\%).}
}

@article{alghtus2025aipowered,
  title     = {AI-Powered Machine Learning Approaches for Fault Diagnosis in Industrial Pumps},
  author    = {Alghtus, K.M.A. and others},
  year      = {2025},
  eprint    = {2508.15550},
  archiveprefix = {arXiv},
  url       = {https://arxiv.org/html/2508.15550v1},
  abstract  = {Pipeline completo para detección temprana de fallos en bombas centrífugas usando datos reales. Random Forest y XGBoost logran ~99-100\% de precisión, mientras que SVM falla en detectar alertas críticas. Propone un método de doble umbral (fijo + adaptativo al percentil 95) para etiquetado más sensible.}
}
